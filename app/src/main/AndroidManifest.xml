<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 부분 영역 선택 오버레이 (기능명세서 2.2절) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 최소 권한 원칙 (CLAUDE.md 7절): WorkManager가 병합하는 재부팅 재스케줄 권한 제거
         (압축 작업은 재부팅 후 자동 재개 대신 사용자 재시도로 충분하다) -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <application
        android:name=".ScreenRecorderApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenRecorder">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 플로팅 버블 → MediaProjection 동의 트램폴린 (기능명세서 11.1절).
             exported=false + 패키지 지정 인텐트로만 열리므로 외부 앱이 동의 플로를 띄울 수 없다.
             noHistory는 쓰지 않는다: 시스템 동의 액티비티가 위로 올라오면 이 액티비티가 안 보이게 되어
             즉시 finish돼 동의 결과 콜백이 사라진다. 결과를 받은 뒤 스스로 finish()한다. -->
        <activity
            android:name=".CaptureConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.ScreenRecorder.Transparent">
            <intent-filter>
                <action android:name="io.rami.screenrecorder.action.CONSENT_RECORD" />
                <action android:name="io.rami.screenrecorder.action.CONSENT_SCREENSHOT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
