<?xml version="1.0" encoding="utf-8"?>
<!--
  Kinetic 브랜드 마크: 링 + 중앙 점(REC). design/new_design의 CircleDot과 같은 형태로,
  앱 셸 좌측 레일의 브랜드 마크·홈의 녹화 버튼과 동일한 상징을 쓴다.
  콘텐츠는 어댑티브 아이콘 안전 영역(중앙 원, 지름 66dp) 안에 배치한다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 바깥 링 (지름 61dp: 안전 영역 내부) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#EF4444"
        android:strokeWidth="7"
        android:pathData="M54,27a27,27 0 1,0 0,54a27,27 0 1,0 0,-54z" />

    <!-- 중앙 REC 점 -->
    <path
        android:fillColor="#EF4444"
        android:pathData="M54,43a11,11 0 1,0 0,22a11,11 0 1,0 0,-22z" />
</vector>
