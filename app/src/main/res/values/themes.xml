<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose가 전체 UI를 그리므로 최소한의 플랫폼 테마만 유지한다.
         DayNight 계열로 시스템 다크 모드 시 데코 뷰(상태바 전환 순간)가 어긋나지 않게 한다.
         스플래시 테마는 Stage 6에서 androidx.core.splashscreen으로 구성한다. -->
    <style name="Theme.ScreenRecorder" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
