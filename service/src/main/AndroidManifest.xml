<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <service
            android:name="io.rami.screenrecorder.service.RecordingForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- 플로팅 캡처 버블 유지용. 화면 녹화 세션과 수명이 다르므로 서비스를 분리한다. -->
        <service
            android:name="io.rami.screenrecorder.service.FloatingCaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled floating capture button visible over other apps" />
        </service>
    </application>
</manifest>
